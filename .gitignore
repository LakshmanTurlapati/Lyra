# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Testing
.pytest_cache/

# Dataset files (large, generated)
datasets/**/*.jsonl
datasets/**/*.json
!datasets/**/.gitkeep
# Raw per-phase JSONL is tracked via LFS (see .gitattributes)
!datasets/*/raw-*/**/*.jsonl

# Virtual environments
venv/
.venv/

# Model cache
.cache/

# Training checkpoints (large, reproducible intermediates)
models/**/checkpoint-*/

# Model weights and tokenizers (too large for GitHub LFS; publish to HF Hub instead)
models/**/*.safetensors
models/**/*.bin
models/**/*.pt
models/**/*.pth
models/**/tokenizer.json

# Assembled dataset (binary Arrow files, reproducible from source JSONL + script)
datasets/assembled/

# HuggingFace datasets runtime caches (regenerated on load; not canonical data)
datasets/**/cache-*.arrow

# Claude Code local workspace (settings + agent worktrees; never tracked)
.claude/

# Environment
.env
